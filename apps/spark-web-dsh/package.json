{
  "name": "@zendev-lab/spark-web-dsh",
  "version": "0.4.0",
  "private": true,
  "description": "Spark web application: boots the DeepSeek Harness profile with Spark-owned tools, remote-HTTP compatibility, and bounded cold history.",
  "license": "MIT",
  "author": "zrr1999",
  "bin": {
    "spark-web-dsh": "./bin/spark-web-dsh"
  },
  "files": [
    "bin/**/*",
    "lib/**/*.js",
    "presets/**/*",
    "skills/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./executable": "./bin/spark-web-dsh",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run",
    "verify:presets": "node scripts/verify-presets.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@zendev-lab/dsh-tool-cue": "workspace:^",
    "@zendev-lab/spark-llm": "workspace:^",
    "esbuild": "^0.28.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@types/react": "^19.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "connection",
        "remote"
      ]
    }
  }
}
