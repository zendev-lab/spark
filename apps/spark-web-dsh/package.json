{
  "name": "@zendev-lab/spark-web-dsh",
  "version": "0.5.0",
  "private": true,
  "description": "Spark web application: boots the DeepSeek Harness profile with Spark-owned tools, remote-HTTP compatibility, and bounded cold history.",
  "license": "MIT",
  "author": "zrr1999",
  "bin": {
    "spark-web-dsh": "./bin/spark-web-dsh"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "presets/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./executable": "./bin/spark-web-dsh",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run",
    "verify:presets": "node scripts/verify-presets.mjs"
  },
  "dependencies": {
    "@zendev-lab/cue": "catalog:",
    "@zendev-lab/dsh-cue": "workspace:^",
    "@zendev-lab/dsh-tool-cue": "workspace:^",
    "@zendev-lab/dsh-tool-fusion": "workspace:^",
    "@zendev-lab/dsh-tool-web": "workspace:^",
    "@zendev-lab/spark-daemon-client": "workspace:^",
    "@zendev-lab/spark-files": "workspace:^",
    "@zendev-lab/spark-llm-providers": "workspace:^",
    "@zendev-lab/spark-session": "workspace:^",
    "esbuild": "^0.28.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "connection",
        "remote"
      ]
    }
  }
}
