{
  "name": "@zendev-lab/spark-daemon",
  "version": "0.5.0",
  "private": true,
  "description": "Spark daemon service for workspace execution.",
  "bin": {
    "spark-daemon": "./bin/spark-daemon"
  },
  "files": [
    "bin",
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./headless-role-executor": "./src/headless-role-executor.ts"
  },
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "cli": "pnpm run build && node dist/cli.js",
    "prepack": "pnpm run build",
    "test": "vp test run",
    "start": "pnpm run build && node dist/cli.js start",
    "doctor": "pnpm run build && node dist/cli.js doctor",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.0",
