{
  "name": "@zendev-lab/spark-docs",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "build:cloudflare": "pnpm run check:deploy && pnpm run check",
    "preview": "astro preview --port 4322",
    "test": "pnpm run test:locale",
    "test:locale": "node --test src/lib/docs-locale.test.mjs",
    "check:deploy": "node ../../scripts/require-docs-deploy-env.mjs",
    "check": "pnpm run test:locale && astro check && astro build",
    "deploy": "pnpm run build:cloudflare && pnpm run deploy:cloudflare",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.2",
    "starlight-versions": "0.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "catalog:",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11 <12"
  }
}
