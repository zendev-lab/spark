{
  "name": "@zendev-lab/spark-web",
  "version": "0.4.0",
  "private": true,
  "description": "Spark web application: boots the DeepSeek Harness web profile with Spark-owned Cue, LLM, and provider-onboarding plugins.",
  "license": "MIT",
  "author": "zrr1999",
  "bin": {
    "spark-web": "./bin/spark-web"
  },
  "files": [
    "bin/**/*",
    "lib/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./executable": "./bin/spark-web",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run"
  },
  "dependencies": {
    "@zendev-lab/dsh-tool-cue": "workspace:^",
    "@zendev-lab/spark-llm": "workspace:^",
    "esbuild": "^0.28.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "connection",
        "remote"
      ]
    }
  }
}
