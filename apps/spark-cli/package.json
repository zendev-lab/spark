{
  "name": "@zendev-lab/spark-cli",
  "version": "0.5.0",
  "private": true,
  "description": "Native root Spark CLI with Node companion process routing.",
  "license": "MIT",
  "author": "zrr1999",
  "bin": {
    "spark": "./bin/spark"
  },
  "files": [
    "bin/**/*",
    "src/paths.ts",
    "native/Cargo.toml",
    "native/src/**/*.rs",
    "README.md"
  ],
