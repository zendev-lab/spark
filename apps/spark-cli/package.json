  "scripts": {
    "check": "vp check --no-fmt --no-lint . && cargo clippy -p spark-cli --all-targets -- -D warnings",
    "test": "cargo test -p spark-cli"
  },
  "dependencies": {
    "@zendev-lab/spark-i18n": "workspace:^",
    "@zendev-lab/spark-system": "workspace:^"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
