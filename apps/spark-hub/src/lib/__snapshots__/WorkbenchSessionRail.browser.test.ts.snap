exports[`WorkbenchSessionRail browser contract > persists Show archived in the URL while preserving the Side Thread hierarchy 1`] = `"<div class="session-rail svelte-7u7zhk"><h2 class="session-list-title svelte-7u7zhk">All conversations</h2> <div class="session-toolbar svelte-7u7zhk"><label class="session-filter svelte-7u7zhk"><!----><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lucide-icon lucide lucide-search"><!----><path d="m21 21-4.34-4.34"></path><!----><circle cx="11" cy="11" r="8"></circle><!----><!----></svg><!----> <input data-session-filter="" type="search" class="svelte-7u7zhk" aria-label="Filter conversations" placeholder="Filter conversations"></label> <a class="archived-toggle svelte-7u7zhk" href="/?rail=hierarchy&amp;archived=1" data-active="false">Show archived (1)</a><!----> <!----><a class="new-session svelte-7u7zhk" href="/spark/sessions?new=workspace" aria-label="New conversation" title="New conversation"><!----><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lucide-icon lucide lucide-message-square-plus"><!----><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path><!----><path d="M12 8v6"></path><!----><path d="M9 11h6"></path><!----><!----></svg><!----> <span class="sr-only svelte-7u7zhk">New conversation</span></a><!----></div> <!----> <div class="session-groups svelte-7u7zhk" aria-label="All conversations"><details class="session-group svelte-7u7zhk" open=""><summary class="svelte-7u7zhk"><span>Workspace chats</span> <span class="group-meta svelte-7u7zhk"><span class="group-count svelte-7u7zhk">5</span> <span class="group-disclosure svelte-7u7zhk