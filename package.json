{
  "name": "@zendev-lab/spark",
  "version": "0.3.0",
  "private": true,
  "description": "Spark monorepo: daemon-first agent orchestration across TUI, Hub, and channels, with Pi retained only as an SDK kernel.",
  "keywords": [
    "Agentic Workflow",
    "Coding Agent",
    "Spark"
  ],
  "homepage": "https://github.com/zendev-lab/spark#readme",
  "bugs": {
    "url": "https://github.com/zendev-lab/spark/issues"
  },
  "license": "MIT",
  "author": "zrr1999",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zendev-lab/spark.git"
  },
  "bin": {
    "spark": "./apps/spark-cli/bin/spark"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm run check:static && pnpm run check:docs && pnpm run test:unit && pnpm run test:process:source",
    "check:static": "pnpm --filter @zendev-lab/spark-hub exec svelte-kit sync && pnpm --filter @zendev-lab/spark-docs exec astro sync && node scripts/sync-workspace-versions.mjs && pnpm exec prek run actionlint --all-files && pnpm exec prek run zizmor --all-files && pnpm run check:pi-extensions && pnpm run check:architecture && pnpm run check:tool-surface && pnpm run check:boundaries && vp fmt . --check && vp lint --quiet --report-unused-disable-directives-severity error && pnpm run typecheck",
    "check:pi-extensions": "node scripts/check-pi-extensions.mjs",
    "check:architecture": "prek run check-jsonschema check-metaschema --files architecture/packages.json architecture/packages.schema.json && syncpack lint --config .syncpackrc.json --no-ansi && knip --strict --include unlisted --no-progress --no-config-hints && node scripts/check-architecture-ratchets.mjs",
    "check:tool-surface": "node --experimental-strip-types scripts/check-tool-surface.mts",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages test",
    "fix": "pnpm --filter @zendev-lab/spark-hub exec svelte-kit sync && vp fmt . --write && vp lint --fix --quiet && pnpm run typecheck",
    "typecheck": "pnpm --filter @zendev-lab/spark-hub run check && vp check --no-fmt --no-lint && pnpm --filter @zendev-lab/spark-daemon run check",
    "test": "vp test run --config vitest.root.config.ts",
    "test:unit": "pnpm --filter @zendev-lab/spark-hub exec svelte-kit sync && vp test run --config vitest.root.config.ts && pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:process:source": "pnpm --filter @zendev-lab/spark-hub run build && vp test run --config vitest.process.config.ts",
    "test:journey:repro": "pnpm --filter @zendev-lab/spark-hub run build && vp test run --config vitest.journey.config.ts",
    "test:browser": "pnpm run test:browser:hub && pnpm run test:browser:ui",
    "test:browser:hub": "pnpm --filter @zendev-lab/spark-hub run test:browser",
    "test:browser:ui": "pnpm --filter @zendev-lab/spark-ui run test:browser",
    "test:capability": "vp test run --config vitest.capability.config.ts",
    "test:capability:ce": "node --experimental-strip-types scripts/run-nightly-capability-ce.mts",
    "test:mutation": "pnpm -r --workspace-concurrency=1 --filter './packages/*' --if-present run test:mutation",
    "bench:lens": "vp test bench --config benchmarks/lens/vitest.config.ts",
    "bench:lens:codspeed": "vp test bench --config benchmarks/lens/vitest.config.ts --run",
    "build": "pnpm --filter @zendev-lab/spark-daemon run build && pnpm --filter @zendev-lab/spark-hub run build",
    "release:pack": "node scripts/pack-release.mjs",
    "release:lint": "node scripts/lint-release-packages.mjs",
    "build:docs": "pnpm --filter @zendev-lab/spark-docs run build",
    "check:docs": "pnpm --filter @zendev-lab/spark-docs run check",
    "deploy:docs": "pnpm --filter @zendev-lab/spark-docs run deploy",
    "dev:docs": "pnpm --filter @zendev-lab/spark-docs run dev",
    "preview": "pnpm --filter @zendev-lab/spark-hub run dev",
    "preview:docs": "pnpm --filter @zendev-lab/spark-docs run preview",
    "smoke": "node scripts/smoke-npm-product.mjs",
    "audit": "pnpm audit --registry=https://registry.npmjs.org/ --audit-level high",
    "report:hygiene": "node scripts/report-hygiene.mjs",
    "prepare": "prek install --hook-type commit-msg --hook-type pre-commit"
  },
  "dependencies": {
    "@zendev-lab/spark-ai": "workspace:^",
    "@zendev-lab/spark-artifacts": "workspace:^",
    "@zendev-lab/spark-ask": "workspace:^",
    "@zendev-lab/spark-channels": "workspace:^",
    "@zendev-lab/spark-core": "workspace:^",
    "@zendev-lab/spark-cue": "workspace:^",
    "@zendev-lab/spark-extension": "workspace:^",
    "@zendev-lab/spark-files": "workspace:^",
    "@zendev-lab/spark-fusion": "workspace:^",
    "@zendev-lab/spark-graft": "workspace:^",
    "@zendev-lab/spark-host": "workspace:^",
    "@zendev-lab/spark-hub-coordination": "workspace:^",
    "@zendev-lab/spark-loop": "workspace:^",
    "@zendev-lab/spark-mcp": "workspace:^",
    "@zendev-lab/spark-memory": "workspace:^",
    "@zendev-lab/spark-protocol": "workspace:^",
    "@zendev-lab/spark-repro": "workspace:^",
    "@zendev-lab/spark-roles": "workspace:^",
    "@zendev-lab/spark-runtime": "workspace:^",
    "@zendev-lab/spark-session": "workspace:^",
    "@zendev-lab/spark-tasks": "workspace:^",
    "@zendev-lab/spark-tui": "workspace:^",
    "@zendev-lab/spark-tui-adapter": "workspace:^",
    "@zendev-lab/spark-turn": "workspace:^",
    "@zendev-lab/spark-update": "workspace:^",
    "@zendev-lab/spark-web": "workspace:^",
    "@zendev-lab/spark-workflows": "workspace:^",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "5.7.1",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@j178/prek": "0.4.12",
    "@types/node": "^26.1.1",
    "@zendev-lab/spark-daemon-client": "workspace:*",
    "@zendev-lab/spark-hub-db": "workspace:*",
    "@zendev-lab/spark-lens": "workspace:^",
    "@zendev-lab/spark-system": "workspace:*",
    "ajv": "8.20.0",
    "dependency-cruiser": "^18.1.0",
    "es-toolkit": "catalog:",
    "esbuild": "^0.28.0",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "p-retry": "catalog:",
    "publint": "0.3.23",
    "syncpack": "15.3.2",
    "tsx": "^4.20.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.20.0",
  "pi": {
    "extensions": [
      "./packages/spark-ask/src/extension-entry.ts",
      "./packages/spark-artifacts/src/extension-entry.ts",
      "./packages/spark-cue/src/extension/index.ts",
      "./packages/spark-ai/src/models-extension.ts",
      "./packages/spark-roles/src/extension-entry.ts",
      "./packages/spark-session/src/extension-entry.ts",
      "./packages/spark-memory/src/extension-entry.ts",
      "./packages/spark-web/src/extension-entry.ts",
      "./packages/spark-ai/src/baidu-oneapi-compat-extension.ts",
      "./packages/spark-extension/src/extension/index.ts"
    ]
  },
  "sparkRelease": {
    "minimumUpdaterVersion": "0.2.0",
    "rollbackCompatibility": ">=0.2.0 <0.3.0",
    "migrationMode": "expand-only"
  }
}
