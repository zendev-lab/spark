{
  "schemaVersion": 1,
  "adjacentReleaseWindow": 1,
  "firstSplitRelease": "0.3.0",
  "fullMatrixRequiredFrom": "0.4.0",
  "components": ["hub", "daemon", "tui"],
  "edges": [
    {
      "id": "hub-daemon",
      "left": "hub",
      "right": "daemon",
      "surfaces": ["runtime-websocket", "local-control-rpc"]
    },
    {
      "id": "daemon-tui",
      "left": "daemon",
      "right": "tui",
      "surfaces": ["local-control-rpc", "view-event-stream"]
    }
  ],
  "releaseGate": {
    "artifactMode": "exact-tarballs",
    "requiredPhases": [
      {
        "id": "candidate-hub--baseline-daemon",
        "left": "candidate-hub",
        "right": "baseline-daemon"
      },
      {
        "id": "baseline-hub--candidate-daemon",
        "left": "baseline-hub",
        "right": "candidate-daemon"
      },
      {
        "id": "candidate-tui--baseline-daemon",
        "left": "candidate-tui",
        "right": "baseline-daemon"
      },
      {
        "id": "baseline-tui--candidate-daemon",
        "left": "baseline-tui",
        "right": "candidate-daemon"
      }
    ],
    "sameVersionSanity": true,
    "firstSplitReleaseException": {
      "candidateVersion": "0.3.0",
      "baselineVersion": "0.2.1",
      "reason": "The published baseline is the legacy all-in-one package and has no independently published Hub or TUI artifacts. The complete split-product matrix becomes mandatory once 0.3.0 is the published N-1 baseline."
    }
  },
  "protocol": {
    "productVersionIsWireVersion": false,
    "featureNegotiation": "intersection",
    "unknownOptionalFields": "ignore-with-deterministic-defaults",
    "unknownRequiredCapabilities": "reject-with-actionable-diagnostic",
    "breakingChangeBridgeReleases": 1
  },
  "database": {
    "metadataRequiredFrom": "0.4.0",
    "owners": [
      {
        "id": "daemon",
        "migrationManifest": "apps/spark-daemon/src/store/migrations/manifest.json"
      },
      {
        "id": "hub",
        "migrationManifest": "packages/spark-hub-db/src/migrations/manifest.json"
      }
    ],
    "migrationPhases": ["expand", "backfill", "contract"],
    "automaticUpdatePhases": ["expand"],
    "minimumContractDelayReleases": 2,
    "requireMigrationChecksums": true,
    "requireImmutableAppliedMigrations": true,
    "requireNMinusOneReadWrite": true,
    "requireIdempotentReopen": true,
    "requireCrashRecovery": true,
    "rejectUnsupportedFutureSchema": true,
    "rollbackRestoresDatabase": false
  }
}
