{
  "$schema": "./packages.schema.json",
  "schemaVersion": 2,
  "governance": {
    "layerPolicy": {
      "tiers": {
        "application": 5,
        "composition": 4,
        "adapter": 3,
        "client": 3,
        "runtime": 3,
        "private-adapter": 3,
        "capability": 2,
        "contract": 1,
        "foundation": 1,
        "compatibility": 1,
        "experiment": 5
      },
      "peerLayerGroups": [
        ["adapter", "client", "runtime"],
        ["contract", "foundation", "compatibility"]
      ],
      "denySameLayerDependencies": ["application", "experiment"],
      "targetRestrictions": [
        {
          "targetLayer": "private-adapter",
          "allowedFromLayers": ["private-adapter"],
          "allowedFromPackages": ["@zendev-lab/spark-hub", "@zendev-lab/spark-web"]
        },
        {
          "targetLayer": "experiment",
          "allowedFromLayers": ["experiment"],
          "allowedFromPackages": []
        }
      ]
    },
    "temporaryDependencyExceptions": [
      {
        "from": "@zendev-lab/spark-artifacts",
        "to": "@zendev-lab/spark-daemon-client",
        "toLayer": "client",
        "reason": "Artifact persistence still reaches the daemon transport before the daemon-client port inversion.",
        "owner": "artifacts",
        "exitTask": "task:6a9bde44-5cfe-4e78-9a0e-ead159701b55",
        "nonGrowth": true
      },
      {
        "from": "@zendev-lab/spark-files",
        "to": "@zendev-lab/spark-daemon-client",
        "toLayer": "client",
        "reason": "File capability persistence still reaches the daemon transport before the daemon-client port inversion.",
        "owner": "files",
        "exitTask": "task:6a9bde44-5cfe-4e78-9a0e-ead159701b55",
        "nonGrowth": true
      },
      {
        "from": "@zendev-lab/spark-session",
        "to": "@zendev-lab/spark-daemon-client",
        "toLayer": "client",
        "reason": "Session compatibility actions still call the daemon client until the session port is inverted.",
        "owner": "sessions",
        "exitTask": "task:6a9bde44-5cfe-4e78-9a0e-ead159701b55",
        "nonGrowth": true
      }
    ],
    "temporaryDependencyExceptionBudget": {
      "current": 3,
      "ceiling": 3,
      "nonGrowth": true
    },
    "piOwnership": {
      "productManifestOwner": null,
      "temporaryProductManifestExceptions": [],
      "sdkDependencies": [
        {
          "dependency": "@earendil-works/pi-ai",
          "owner": "@zendev-lab/spark-llm-providers"
        }
      ],
      "temporaryDependencyExceptions": []
    },
    "packageBudget": {
      "current": 40,
      "ceiling": 40,
      "nonGrowth": true,
      "reason": "The 40-workspace transition graph still contains spark-host and spark-turn; ten in-place renames and deletion of spark-host, spark-turn, and spark-modes converge to 38 while native spark-web and spark-web-dsh remain explicit applications. spark-modes was removed here: durable session modes are retired in favor of one-shot /plan, /execute, and /fleet commands."
    },
    "packageNaming": {
      "temporaryDshDependencyExceptionsNonGrowth": true
    },
    "compositionRoots": ["@zendev-lab/spark-daemon"]
  },
  "packages": {
    "@zendev-lab/dsh-channel-transports": {
      "path": "packages/dsh-channel-transports",
