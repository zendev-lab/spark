      "stateWriter": "none",
      "distribution": "private",
      "dshIndependenceException": {
        "dependencies": ["@zendev-lab/spark-cue"],
        "reason": "The existing Cue tool adapter still consumes the pre-Cordis Spark Cue execution kernel.",
        "exitCondition": "Remove when the Cue execution kernel becomes the independent dsh-cue service."
      }
    },
