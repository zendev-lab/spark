{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark.zendev-lab.dev/schemas/architecture-packages.schema.json",
  "title": "Spark Package Architecture Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "governance", "packages"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^@zendev-lab/(?:(?:spark|pi)-[a-z0-9-]+|dsh-tool-cue)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "layer": {
      "enum": [
        "application",
        "composition",
        "adapter",
        "client",
        "runtime",
        "private-adapter",
        "capability",
        "contract",
        "foundation",
        "compatibility",
        "experiment"
      ]
    },
    "packageName": {
      "type": "string",
      "pattern": "^@zendev-lab/(?:(?:spark|pi)-[a-z0-9-]+|dsh-tool-cue)$"
    },
    "taskRef": {
      "type": "string",
      "pattern": "^task:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "exitMetadata": {
      "type": "object",
      "required": ["reason", "owner", "exitTask", "nonGrowth"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 24
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "exitTask": {
          "$ref": "#/$defs/taskRef"
        },
        "nonGrowth": {
          "const": true
        }
      }
    },
    "dependencyException": {
      "allOf": [
        {
          "$ref": "#/$defs/exitMetadata"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "toLayer", "reason", "owner", "exitTask", "nonGrowth"],
          "properties": {
            "from": {
              "$ref": "#/$defs/packageName"
            },
            "to": {
              "$ref": "#/$defs/packageName"
            },
            "toLayer": {
              "$ref": "#/$defs/layer"
            },
            "reason": true,
            "owner": true,
            "exitTask": true,
            "nonGrowth": true
          }
        }
      ]
    },
    "piProductManifestException": {
      "allOf": [
        {
          "$ref": "#/$defs/exitMetadata"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "reason", "owner", "exitTask", "nonGrowth"],
          "properties": {
            "manifest": {
              "const": "package.json"
            },
            "reason": true,
            "owner": true,
            "exitTask": true,
            "nonGrowth": true
          }
        }
      ]
    },
    "piDependencyException": {
      "allOf": [
        {
          "$ref": "#/$defs/exitMetadata"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "dependency", "reason", "owner", "exitTask", "nonGrowth"],
          "properties": {
            "package": {
              "$ref": "#/$defs/packageName"
            },
            "dependency": {
              "enum": [
                "@earendil-works/pi-ai",
                "@earendil-works/pi-tui",
                "@earendil-works/pi-coding-agent"
              ]
            },
            "reason": true,
            "owner": true,
            "exitTask": true,
            "nonGrowth": true
          }
        }
      ]
    },
    "layerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiers", "peerLayerGroups", "denySameLayerDependencies", "targetRestrictions"],
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "application",
            "composition",
            "adapter",
            "client",
            "runtime",
            "private-adapter",
            "capability",
            "contract",
            "foundation",
            "compatibility",
            "experiment"
          ],
          "properties": {
            "application": { "type": "integer", "minimum": 0 },
            "composition": { "type": "integer", "minimum": 0 },
            "adapter": { "type": "integer", "minimum": 0 },
            "client": { "type": "integer", "minimum": 0 },
            "runtime": { "type": "integer", "minimum": 0 },
            "private-adapter": { "type": "integer", "minimum": 0 },
            "capability": { "type": "integer", "minimum": 0 },
            "contract": { "type": "integer", "minimum": 0 },
            "foundation": { "type": "integer", "minimum": 0 },
            "compatibility": { "type": "integer", "minimum": 0 },
            "experiment": { "type": "integer", "minimum": 0 }
          }
        },
        "peerLayerGroups": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/layer"
            }
          }
        },
        "denySameLayerDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "targetRestrictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["targetLayer", "allowedFromLayers", "allowedFromPackages"],
            "properties": {
              "targetLayer": {
                "$ref": "#/$defs/layer"
              },
              "allowedFromLayers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/layer"
                }
              },
              "allowedFromPackages": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/packageName"
                }
              }
            }
          }
        }
      }
    },
    "piOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productManifestOwner",
        "temporaryProductManifestExceptions",
        "sdkDependencies",
        "temporaryDependencyExceptions"
      ],
      "properties": {
        "productManifestOwner": {
          "$ref": "#/$defs/packageName"
        },
        "temporaryProductManifestExceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piProductManifestException"
          }
        },
        "sdkDependencies": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dependency", "owner"],
            "properties": {
              "dependency": {
                "enum": [
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-tui",
                  "@earendil-works/pi-coding-agent"
                ]
              },
              "owner": {
                "$ref": "#/$defs/packageName"
              }
            }
          }
        },
        "temporaryDependencyExceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piDependencyException"
          }
        }
      }
    },
    "packageBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "ceiling", "nonGrowth", "reason"],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 1
        },
        "ceiling": {
          "type": "integer",
          "minimum": 1
        },
        "nonGrowth": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 24
        }
      }
    },
    "temporaryDependencyExceptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "ceiling", "nonGrowth"],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "ceiling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "nonGrowth": {
          "const": true
        }
      },
      "oneOf": [
        { "properties": { "current": { "const": 0 }, "ceiling": { "const": 0 } } },
        { "properties": { "current": { "const": 1 }, "ceiling": { "const": 1 } } },
        { "properties": { "current": { "const": 2 }, "ceiling": { "const": 2 } } },
        { "properties": { "current": { "const": 3 }, "ceiling": { "const": 3 } } },
        { "properties": { "current": { "const": 4 }, "ceiling": { "const": 4 } } },
        { "properties": { "current": { "const": 5 }, "ceiling": { "const": 5 } } },
        { "properties": { "current": { "const": 6 }, "ceiling": { "const": 6 } } }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerPolicy",
        "temporaryDependencyExceptions",
        "temporaryDependencyExceptionBudget",
        "piOwnership",
        "packageBudget",
        "compositionRoots"
      ],
      "properties": {
        "layerPolicy": {
          "$ref": "#/$defs/layerPolicy"
        },
        "temporaryDependencyExceptions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/dependencyException"
          }
        },
        "temporaryDependencyExceptionBudget": {
          "$ref": "#/$defs/temporaryDependencyExceptionBudget"
        },
        "piOwnership": {
          "$ref": "#/$defs/piOwnership"
        },
        "packageBudget": {
          "$ref": "#/$defs/packageBudget"
        },
        "compositionRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/packageName"
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "layer", "owner", "stability", "stateWriter"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:apps|packages)/[a-z0-9-]+$"
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stability": {
          "enum": ["supported", "internal", "experimental", "private", "retired"]
        },
        "stateWriter": {
          "enum": ["none", "workspace", "user", "host", "daemon", "hub", "external"]
        },
        "allowedWorkspaceDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/packageName"
          }
        },
        "distribution": {
          "enum": ["public-npm", "private"]
        }
      }
    }
  }
}
