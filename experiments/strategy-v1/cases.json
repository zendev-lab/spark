{
  "pr-checks": [
    {
      "id": "open-pass",
      "visibility": "public",
      "input": {
        "required": [
          {
            "name": "pass",
            "state": "PASS",
            "bucket": "pass"
          }
        ]
      },
      "expected": {
        "verdict": "pass",
        "checks": 1
      }
    },
    {
      "id": "merged-skipped",
      "visibility": "public",
      "input": {
        "state": "MERGED",
        "recorded": [
          {
            "name": "pass",
            "state": "PASS",
            "bucket": "pass"
          },
          {
            "name": "skipping",
            "state": "SKIPPING",
            "bucket": "skipping"
          }
        ]
      },
      "expected": {
        "verdict": "pass",
        "checks": 2
      }
    },
    {
      "id": "open-skipped",
      "visibility": "hidden",
      "input": {
        "required": [
          {
            "name": "skipping",
            "state": "SKIPPING",
            "bucket": "skipping"
          }
        ]
      },
      "expected": {
        "verdict": "inconclusive",
        "checks": 1
      }
    },
    {
      "id": "merged-pending",
      "visibility": "hidden",
      "input": {
        "state": "MERGED",
        "recorded": [
          {
            "name": "pending",
            "state": "PENDING",
            "bucket": "pending"
          }
        ]
      },
      "expected": {
        "verdict": "inconclusive",
        "checks": 1
      }
    },
    {
      "id": "merged-failure",
      "visibility": "hidden",
      "input": {
        "state": "MERGED",
        "recorded": [
          {
            "name": "fail",
            "state": "FAIL",
            "bucket": "fail"
          },
          {
            "name": "skipping",
            "state": "SKIPPING",
            "bucket": "skipping"
          }
        ]
      },
      "expected": {
        "verdict": "fail",
        "checks": 2
      }
    },
    {
      "id": "merged-cancel",
      "visibility": "hidden",
      "input": {
        "state": "MERGED",
        "recorded": [
          {
            "name": "cancel",
            "state": "CANCEL",
            "bucket": "cancel"
          }
        ]
      },
      "expected": {
        "verdict": "fail",
        "checks": 1
      }
    },
    {
      "id": "merged-empty",
      "visibility": "hidden",
      "input": {
        "state": "MERGED"
      },
      "expected": {
        "verdict": "inconclusive",
        "checks": 0
      }
    },
    {
      "id": "open-empty",
      "visibility": "hidden",
      "input": {
        "recorded": [
          {
            "name": "pass",
            "state": "PASS",
            "bucket": "pass"
          }
        ]
      },
      "expected": {
        "verdict": "inconclusive",
        "checks": 0
      }
    },
    {
      "id": "dirty",
      "visibility": "hidden",
      "input": {
        "dirty": true,
        "required": [
          {
            "name": "pass",
            "state": "PASS",
            "bucket": "pass"
          }
        ]
      },
      "expected": {
        "verdict": "stale",
        "checks": 0
      }
    },
    {
      "id": "head-mismatch",
      "visibility": "hidden",
      "input": {
        "remoteHead": "head-2",
        "required": [
          {
            "name": "pass",
            "state": "PASS",
            "bucket": "pass"
          }
        ]
      },
      "expected": {
        "verdict": "stale",
        "checks": 0
      }
    },
    {
      "id": "merged-required-skipped",
      "visibility": "hidden",
      "input": {
        "state": "MERGED",
        "required": [
          {
            "name": "skipping",
            "state": "SKIPPING",
            "bucket": "skipping"
          }
        ],
        "recorded": [
          {
            "name": "pass",
            "state": "PASS",
            "bucket": "pass"
          }
        ]
      },
      "expected": {
        "verdict": "inconclusive",
        "checks": 1
      }
    },
    {
      "id": "merged-all-skipped",
      "visibility": "hidden",
      "input": {
        "state": "MERGED",
        "recorded": [
          {
            "name": "skipping",
            "state": "SKIPPING",
            "bucket": "skipping"
          }
        ]
      },
      "expected": {
        "verdict": "pass",
        "checks": 1
      }
