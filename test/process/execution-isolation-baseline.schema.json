{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark.zendev-lab.dev/schemas/execution-isolation-baseline/v2.json",
  "title": "Spark execution isolation baseline report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "generatedAt", "environment", "assertions", "fixtures"],
  "properties": {
    "$schema": {
      "const": "./test/process/execution-isolation-baseline.schema.json"
    },
    "version": {
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "release",
        "arch",
        "node",
        "commit",
        "sourceTreeDirty",
        "schedulerConcurrency",
        "controlProbeIntervalMs",
        "controlResponsiveGapLimitMs",
        "invocationTimeoutMsByFixture",
        "fixtureParameters",
        "measurementUnits"
      ],
      "properties": {
        "platform": {
          "enum": ["darwin", "linux"]
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "pattern": "^v26\\."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceTreeDirty": {
          "type": "boolean"
        },
        "schedulerConcurrency": {
          "const": 2
        },
        "controlProbeIntervalMs": {
          "const": 100
        },
        "controlResponsiveGapLimitMs": {
          "const": 250
        },
        "invocationTimeoutMsByFixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "abortIgnoringTool", "hungExternalChild"],
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 1
            },
            "abortIgnoringTool": {
              "type": "integer",
              "minimum": 1
            },
            "hungExternalChild": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "fixtureParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "syncCpuDurationMs",
            "asyncProviderReleaseDelayMs",
            "abortIgnoringReleaseDelayMs",
            "attachmentBytes",
            "childTermGraceMs"
          ],
          "properties": {
            "syncCpuDurationMs": {
              "const": 5000
            },
            "asyncProviderReleaseDelayMs": {
              "type": "integer",
              "minimum": 1
            },
            "abortIgnoringReleaseDelayMs": {
              "type": "integer",
              "minimum": 1
            },
            "attachmentBytes": {
              "const": 12582912
            },
            "childTermGraceMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "measurementUnits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timestamps", "durations", "memory"],
          "properties": {
            "timestamps": {
              "const": "unix-ms"
            },
            "durations": {
              "const": "ms"
            },
            "memory": {
              "const": "bytes"
            }
          }
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuGapObserved",
        "cpuPrimaryTerminal",
        "cpuSecondTerminalAfterRelease",
        "asyncProviderControlResponsive",
        "asyncProviderSecondTerminalBeforeRelease",
        "abortIgnoringControlResponsive",
        "abortIgnoringTerminalBeforeSettlement",
        "abortIgnoringSecondQueuedUntilRelease",
        "attachmentTimingRecorded",
        "hungChildControlResponsive",
        "hungChildTerminalBeforeHarnessCleanup",
        "hungChildSecondQueuedUntilRelease",
        "hungChildRequiredSigkill",
        "hungChildSignalTimelineOrdered",
        "hungChildProductionCancelLeftChildAlive",
        "hungChildHarnessCleanupExplicit",
        "allFixtureTeardownsClean"
      ],
      "properties": {
        "cpuGapObserved": { "const": true },
        "cpuPrimaryTerminal": { "const": true },
        "cpuSecondTerminalAfterRelease": { "const": true },
        "asyncProviderControlResponsive": { "const": true },
        "asyncProviderSecondTerminalBeforeRelease": { "const": true },
        "abortIgnoringControlResponsive": { "const": true },
        "abortIgnoringTerminalBeforeSettlement": { "const": true },
        "abortIgnoringSecondQueuedUntilRelease": { "const": true },
        "attachmentTimingRecorded": { "const": true },
        "hungChildControlResponsive": { "const": true },
        "hungChildTerminalBeforeHarnessCleanup": { "const": true },
        "hungChildSecondQueuedUntilRelease": { "const": true },
        "hungChildRequiredSigkill": { "const": true },
        "hungChildSignalTimelineOrdered": { "const": true },
        "hungChildProductionCancelLeftChildAlive": { "const": true },
        "hungChildHarnessCleanupExplicit": { "const": true },
        "allFixtureTeardownsClean": { "const": true }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalMs", "sampleCount", "samples", "maxGapMs", "p95GapMs", "rssBytes"],
      "properties": {
        "intervalMs": {
          "const": 100
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 2
        },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/probeSample"
          }
        },
        "maxGapMs": {
          "type": "integer",
          "minimum": 0
        },
        "p95GapMs": {
          "type": "integer",
          "minimum": 0
        },
        "rssBytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "peak", "after"],
          "properties": {
            "before": {
              "type": "integer",
              "minimum": 1
            },
            "peak": {
              "type": "integer",
              "minimum": 1
            },
            "after": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "responsiveProbe": {
      "allOf": [
        { "$ref": "#/$defs/probe" },
        {
          "type": "object",
          "properties": {
            "maxGapMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 249
            }
          }
        }
      ]
    },
    "probeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestampMs",
        "heartbeat",
        "rssBytes",
        "primaryStatus",
        "secondStatus",
        "secondTerminalAtMs"
      ],
      "properties": {
        "timestampMs": {
          "type": "integer",
          "minimum": 0
        },
        "heartbeat": {
          "type": "integer",
          "minimum": 1
        },
        "rssBytes": {
          "type": "integer",
          "minimum": 1
        },
        "primaryStatus": {
          "type": ["string", "null"],
          "enum": ["queued", "running", "succeeded", "failed", "cancelled", null]
        },
        "secondStatus": {
          "type": ["string", "null"],
          "enum": ["queued", "running", "succeeded", "failed", "cancelled", null]
        },
        "secondTerminalAtMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "sessionId",
        "status",
        "createdAtMs",
        "startedAtMs",
        "terminalAtMs"
      ],
      "properties": {
        "invocationId": {
          "type": "string",
          "pattern": "^inv_[A-Za-z0-9]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "startedAtMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "terminalAtMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "materializationStartedAtMs",
        "materializationCompletedAtMs",
        "materializationDurationMs",
        "probeGapBeforeMs",
        "probeGapAcrossMs",
        "probeGapAfterMs"
      ],
      "properties": {
        "bytes": {
          "const": 12582912
        },
        "materializationStartedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "materializationCompletedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "materializationDurationMs": {
          "type": "integer",
          "minimum": 0
        },
        "probeGapBeforeMs": {
          "type": "integer",
          "minimum": 0
        },
        "probeGapAcrossMs": {
          "type": "integer",
          "minimum": 0
        },
        "probeGapAfterMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "spawnedAtMs",
        "cancelAtMs",
        "aliveAfterProductionCancel",
        "termSentAtMs",
        "killSentAtMs",
        "childExitAtMs",
        "executorSettledAtMs",
        "sessionFenceReleasedAtMs",
        "harnessCleanupAtMs",
        "cleanupOwner",
        "productionCleanupObserved"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "spawnedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "cancelAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "aliveAfterProductionCancel": {
          "const": true
        },
        "termSentAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "killSentAtMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "childExitAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "executorSettledAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "sessionFenceReleasedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "harnessCleanupAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "cleanupOwner": {
          "const": "test-harness"
        },
        "productionCleanupObserved": {
          "const": false
        }
      }
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveChildPidCount"],
      "properties": {
        "liveChildPidCount": {
          "const": 0
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "executionPath", "probe", "teardown"],
      "properties": {
        "id": {
          "enum": [
            "idle-control",
            "sync-cpu",
            "async-provider",
            "abort-ignoring-tool",
            "attachment-sync-io",
            "hung-external-child"
          ]
        },
        "classification": {
          "enum": [
            "control",
            "event-loop-blocked",
            "async-wait",
            "session-fence-occupancy",
            "sync-io",
            "external-child-lifecycle"
          ]
        },
        "executionPath": {
          "enum": [
            "control-probe",
            "SparkAgentLoop.provider",
            "SparkAgentLoop.tool",
            "sessionRunPrompt.materializeTurnFiles"
          ]
        },
        "probe": {
          "$ref": "#/$defs/probe"
        },
        "primary": {
          "$ref": "#/$defs/invocation"
        },
        "second": {
          "$ref": "#/$defs/invocation"
        },
        "releaseAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "terminalBeforeExecutorSettlement": {
          "type": "boolean"
        },
        "secondQueuedUntilRelease": {
          "type": "boolean"
        },
        "attachment": {
          "$ref": "#/$defs/attachment"
        },
        "child": {
          "$ref": "#/$defs/child"
        },
        "teardown": {
          "$ref": "#/$defs/teardown"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "id": { "const": "sync-cpu" } },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": {
              "primary": { "$ref": "#/$defs/invocation" },
              "second": { "$ref": "#/$defs/invocation" },
              "releaseAtMs": { "type": "integer", "minimum": 0 }
            },
            "required": ["primary", "second", "releaseAtMs"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "id": {
                "enum": ["async-provider", "abort-ignoring-tool", "hung-external-child"]
              }
            },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": {
              "probe": {
                "$ref": "#/$defs/responsiveProbe"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "id": { "const": "async-provider" } },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": {
              "primary": { "$ref": "#/$defs/invocation" },
              "second": { "$ref": "#/$defs/invocation" },
              "releaseAtMs": { "type": "integer", "minimum": 0 }
            },
            "required": ["primary", "second", "releaseAtMs"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "id": { "const": "abort-ignoring-tool" } },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": {
              "primary": { "$ref": "#/$defs/invocation" },
              "second": { "$ref": "#/$defs/invocation" },
              "releaseAtMs": { "type": "integer", "minimum": 0 },
              "terminalBeforeExecutorSettlement": { "type": "boolean" },
              "secondQueuedUntilRelease": { "type": "boolean" }
            },
            "required": [
              "primary",
              "second",
              "releaseAtMs",
              "terminalBeforeExecutorSettlement",
              "secondQueuedUntilRelease"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "id": { "const": "attachment-sync-io" } },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": {
              "primary": { "$ref": "#/$defs/invocation" },
              "second": { "$ref": "#/$defs/invocation" },
              "attachment": { "$ref": "#/$defs/attachment" }
            },
            "required": ["primary", "second", "attachment"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "id": { "const": "hung-external-child" } },
            "required": ["id"]
          },
          "then": {
            "type": "object",
            "properties": {
              "primary": { "$ref": "#/$defs/invocation" },
              "second": { "$ref": "#/$defs/invocation" },
              "releaseAtMs": { "type": "integer", "minimum": 0 },
              "terminalBeforeExecutorSettlement": { "type": "boolean" },
              "secondQueuedUntilRelease": { "type": "boolean" },
              "child": { "$ref": "#/$defs/child" }
            },
            "required": [
              "primary",
              "second",
              "releaseAtMs",
              "terminalBeforeExecutorSettlement",
              "secondQueuedUntilRelease",
              "child"
            ]
          }
        }
      ]
    }
  }
}
