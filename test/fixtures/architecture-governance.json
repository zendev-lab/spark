{
  "schemaVersion": 1,
  "governanceTools": [
    {
      "id": "ajv",
      "name": "Ajv CLI",
      "concerns": ["inventory JSON shape, required fields, and enums"],
      "authority": "architecture/packages.schema.json",
      "primarySource": "https://ajv.js.org/packages/ajv-cli.html"
    },
    {
      "id": "syncpack",
      "name": "Syncpack",
      "concerns": ["dependency-version/specifier consistency across manifests"],
      "authority": ".syncpackrc.json",
      "primarySource": "https://github.com/JoshuaKGoldberg/syncpack"
    },
    {
      "id": "dependency-cruiser",
      "name": "Dependency Cruiser",
      "concerns": ["cycles and dependency direction"],
      "authority": ".dependency-cruiser.cjs",
      "primarySource": "https://github.com/sverweij/dependency-cruiser"
    }
  ],
  "retainedSparkChecks": [
    "Spark package identity",
    "owner/state ownership",
    "workspace dependency declarations",
    "workspace budget",
    "frozen compatibility",
    "daemon RPC facade",
    "public distribution",
    "release",
    "migration",
    "documentation",
    "evidence",
    "Lens",
    "acceptance"
  ],
  "removedCheckerRules": [
    {
      "id": "layer-enum",
      "removedSource": "scripts/check-architecture-ratchets.mjs validLayers",
      "rule": "architecture layer must be one of the approved values",
      "authority": "architecture/packages.schema.json + Ajv CLI",
      "independentDefect": "test/architecture-ratchets.test.ts injects invalid layer"
    },
    {
      "id": "owner-nonempty",
      "removedSource": "scripts/check-architecture-ratchets.mjs owner trim check",
      "rule": "owner must contain a non-whitespace value",
      "authority": "architecture/packages.schema.json + Ajv CLI",
      "independentDefect": "test/architecture-ratchets.test.ts injects blank owner"
    },
    {
      "id": "stability-enum",
      "removedSource": "scripts/check-architecture-ratchets.mjs validStabilities",
      "rule": "stability must be one of the approved values",
      "authority": "architecture/packages.schema.json + Ajv CLI",
      "independentDefect": "test/architecture-ratchets.test.ts injects invalid stability"
    },
    {
      "id": "state-writer-enum",
      "removedSource": "scripts/check-architecture-ratchets.mjs validStateWriters",
      "rule": "stateWriter must be one of the approved values",
      "authority": "architecture/packages.schema.json + Ajv CLI",
      "independentDefect": "test/architecture-ratchets.test.ts injects invalid stateWriter"
    },
    {
      "id": "distribution-enum",
      "removedSource": "scripts/check-architecture-ratchets.mjs validDistributions",
      "rule": "distribution, when present, must be one of the approved values",
      "authority": "architecture/packages.schema.json + Ajv CLI",
      "independentDefect": "test/architecture-ratchets.test.ts injects invalid distribution"
    },
    {
      "id": "mutation-script-ownership",
      "removedSource": "scripts/check-architecture-ratchets.mjs root mutation-runner duplication check",
      "rule": "mutation participants use the canonical package-local Stryker command and dependencies",
      "authority": "package-local test:mutation scripts, Stryker configs, and test/package-script-surface.test.ts",
      "independentDefect": "test/package-script-surface.test.ts injects an invalid mutation command"
    }
  ]
}
