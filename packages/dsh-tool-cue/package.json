{
  "name": "@zendev-lab/dsh-tool-cue",
  "version": "0.5.0",
  "private": true,
  "description": "DeepSeek Harness rc.7 adapter for Spark's canonical cue-shell tool operations.",
  "license": "MIT",
  "author": "zrr1999",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "presets/**/*",
    "scripts/**/*",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./presets": "./src/presets.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:dsh-plugin": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/index.mjs --external:@deepseek-ai/* --external:@deepseek-ai/cordis",
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test:real-host": "vp test run src/code-mode.test.ts",
    "verify:presets": "node scripts/verify-presets.mjs",
    "test": "vp test run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:dsh",
    "@deepseek-ai/dsh-shell-env": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@zendev-lab/spark-cue": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-code-runtime": "catalog:dsh",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "esbuild": "^0.28.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
