{
  "basePath": "../..",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "packages/spark-tasks/vitest.mutation.config.ts",
    "related": false
  },
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "ignorePatterns": ["packages/spark-tasks/reports", ".stryker-tmp"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "packages/spark-tasks/reports/mutation/session-todos.html"
  },
  "jsonReporter": {
    "fileName": "packages/spark-tasks/reports/mutation/session-todos.json"
  },
  "incremental": true,
  "incrementalFile": "packages/spark-tasks/reports/mutation/session-todos-incremental.json",
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "ignoreStatic": true,
  "mutate": ["packages/spark-tasks/src/todo-store.ts:108:0-172:0"]
}
