{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "ignorePatterns": ["reports", ".stryker-tmp"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/task-tools.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/task-tools.json"
  },
  "incremental": false,
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "ignoreStatic": true,
  "mutate": [
    "src/extension/task-claim-selection.ts:14:0-29:0",
    "src/extension/spark-plan-tasks-tool-registration.ts:73:0-75:0",
    "src/extension/spark-todo-tool-registration.ts:208:0-222:0",
    "src/extension/spark-release-task-claim-tool-registration.ts:334:0-335:0"
  ]
}
