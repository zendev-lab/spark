{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "ignorePatterns": ["reports", ".stryker-tmp"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/task-tools.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/task-tools.json"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/task-tools-incremental.json",
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "timeoutMS": 30000,
  "concurrency": 2,
  "ignoreStatic": true,
  "mutate": [
    "src/extension/task-claim-selection.ts",
    "src/extension/spark-plan-tasks-tool-registration.ts:72:0-80:0",
    "src/extension/spark-plan-tasks-tool-registration.ts:181:0-220:0",
    "src/extension/spark-todo-tool-registration.ts:150:0-238:0",
    "src/extension/spark-finish-task-tool-registration.ts:181:0-207:0",
    "src/extension/spark-finish-task-tool-registration.ts:330:0-420:0",
    "src/extension/spark-finish-task-tool-registration.ts:900:0-1015:0",
    "src/extension/spark-release-task-claim-tool-registration.ts:85:0-180:0"
  ]
}
