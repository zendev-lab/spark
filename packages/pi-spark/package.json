{
  "name": "@zendev-lab/pi-spark",
  "version": "0.4.0",
  "private": true,
  "description": "Pi product compatibility adapter: the only package.json#pi owner, composing spark-extension plus the Pi compatibility profile.",
  "license": "MIT",
  "author": "zrr1999",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/extension.ts",
    "./extension": "./src/extension.ts"
  },
  "scripts": {
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run"
  },
  "dependencies": {
    "@zendev-lab/spark-llm": "workspace:^",
    "@zendev-lab/spark-artifacts": "workspace:^",
    "@zendev-lab/spark-ask": "workspace:^",
    "@zendev-lab/spark-core": "workspace:^",
    "@zendev-lab/spark-cue": "workspace:^",
    "@zendev-lab/spark-extension": "workspace:^",
    "@zendev-lab/spark-memory": "workspace:^",
    "@zendev-lab/spark-roles": "workspace:^",
    "@zendev-lab/spark-session": "workspace:^",
    "@zendev-lab/spark-web": "workspace:^"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
