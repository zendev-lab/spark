{
  "name": "@zendev-lab/spark-artifacts",
  "version": "0.3.0",
  "private": true,
  "description": "Atomic issue/git_change/document Artifacts, Git lifecycle, and internal evidence storage for Spark hosts.",
  "license": "MIT",
  "author": "zrr1999",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./evidence-migration": "./src/evidence-migration.ts",
    "./extension": "./src/extension.ts",
    "./preview-renderer": "./src/artifact/preview-renderer.ts",
    "./artifact": "./src/artifact/index.ts"
  },
  "scripts": {
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@zendev-lab/spark-core": "workspace:^",
    "@zendev-lab/spark-daemon-client": "workspace:^",
    "@zendev-lab/spark-lens": "workspace:^",
    "@zendev-lab/spark-protocol": "workspace:^",
    "@zendev-lab/spark-system": "workspace:^",
    "@zendev-lab/spark-text": "workspace:^",
    "marked": "^18.0.7",
    "sanitize-html": "^2.17.6",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pi": {
    "extensions": [
      "./src/extension-entry.ts"
    ]
  }
}
