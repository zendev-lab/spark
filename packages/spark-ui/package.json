{
  "name": "@zendev-lab/spark-ui",
  "version": "0.3.0",
  "private": true,
  "description": "Spark-owned Svelte UI components, streaming Markdown, design tokens, and icons.",
  "license": "MIT",
  "author": "zrr1999",
  "files": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.css",
    "src/markdown/UPSTREAM-LICENSE.txt",
    "src/markdown/VENDOR.md",
    "src/conversation/UPSTREAM-LICENSE.txt",
    "src/conversation/VENDOR.md",
    "svelte.config.js",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./a2ui": {
      "types": "./src/a2ui.ts",
      "svelte": "./src/a2ui.ts",
      "default": "./src/a2ui.ts"
    },
    "./headless": {
      "types": "./src/ui/headless.ts",
      "svelte": "./src/ui/headless.ts",
      "default": "./src/ui/headless.ts"
    },
    "./markdown": {
      "types": "./src/markdown/index.ts",
      "svelte": "./src/markdown/index.ts",
      "default": "./src/markdown/index.ts"
    },
    "./git-change": {
      "types": "./src/git-change.ts",
      "svelte": "./src/git-change.ts",
      "default": "./src/git-change.ts"
    },
    "./conversation": {
      "types": "./src/conversation/index.ts",
      "svelte": "./src/conversation/index.ts",
      "default": "./src/conversation/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./status-pill.css": "./src/ui/status-pill.css"
  },
  "scripts": {
    "catalog:build": "vp build catalog",
    "catalog:dev": "vp dev catalog",
    "check": "vp check --no-fmt --no-lint . && vp test run --config vitest.config.ts && pnpm run catalog:build",
    "test": "vp test run --config vitest.config.ts",
    "test:browser": "vp test run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.16.0",
    "@zendev-lab/spark-protocol": "workspace:*",
    "bits-ui": "^2.18.1",
    "svelte-streamdown": "^3.1.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "catalog:",
    "playwright": "1.62.1",
    "svelte": "^5.38.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "3.0.0"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
