{
  "name": "@zendev-lab/spark-files",
  "version": "0.3.0",
  "private": true,
  "description": "Working-tree file tools (read/edit/write/grep/find) for Spark extension hosts, with bounded output, versioned reads, atomic writes, and diff semantics.",
  "keywords": [
    "file-tools",
    "spark-extension",
    "spark-package"
  ],
  "license": "MIT",
  "author": "zrr1999",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts"
  },
  "scripts": {
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run"
  },
  "dependencies": {
    "@zendev-lab/spark-artifacts": "workspace:^",
    "@zendev-lab/spark-core": "workspace:^",
    "@zendev-lab/spark-daemon-client": "workspace:^",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "minimatch": "^10.2.5",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
