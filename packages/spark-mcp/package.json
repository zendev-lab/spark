{
  "name": "@zendev-lab/spark-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Supported stateless MCP stdio adapter for canonical Spark Memory reads.",
  "license": "MIT",
  "author": "zrr1999",
  "bin": {
    "spark-mcp": "./bin/spark-mcp.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "bin/**/*.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./executable": "./bin/spark-mcp.ts"
  },
  "scripts": {
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run",
    "stdio": "node --experimental-strip-types ./bin/spark-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@zendev-lab/spark-memory": "workspace:^",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
