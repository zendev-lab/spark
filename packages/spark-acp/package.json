{
  "name": "@zendev-lab/spark-acp",
  "version": "0.4.0",
  "private": true,
  "description": "Supported ACP stdio adapter for daemon-owned Spark sessions.",
  "license": "MIT",
  "author": "zrr1999",
  "bin": {
    "spark-acp": "./bin/spark-acp.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "bin/**/*.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./executable": "./bin/spark-acp.ts"
  },
  "scripts": {
    "check": "vp check --no-fmt --no-lint . && vp test run",
    "test": "vp test run",
    "stdio": "node --experimental-strip-types ./bin/spark-acp.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@optique/core": "catalog:",
    "@zendev-lab/spark-daemon-client": "workspace:^",
    "@zendev-lab/spark-protocol": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
